# ---- Telegram ----
# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=
# Белый список Telegram user id, через запятую. Подскажет scripts/whoami.py.
# Без него бот не стартует: у него полные права на машине.
ALLOWED_USER_IDS=

# ---- Распознавание голосовых ----
STT_LANGUAGE=ru
# ОБЛАЧНЫЙ STT (по умолчанию, для слабого сервера) — через OpenRouter, эндпоинт
# /audio/transcriptions. Отдельный ключ не нужен: если STT_API_KEY пуст, берётся
# LLM_API_KEY ниже (тот же аккаунт OpenRouter). Ставится `install.sh --cloud-stt`,
# тогда тяжёлый локальный whisper не нужен вовсе и LOCAL_STT_FALLBACK=0.
# ЛОКАЛЬНЫЙ путь: оставь ключи пустыми — движок из LOCAL_STT_* работает без сети,
# но грузит CPU и тянет ~400 МБ зависимостей.
STT_BASE_URL=https://openrouter.ai/api/v1
STT_MODEL=openai/whisper-large-v3-turbo
STT_API_KEY=

# ---- Claude Code ----
# Путь к claude CLI подставит scripts/install.sh. Модель — opus/sonnet/haiku.
CLAUDE_BIN=/root/.local/bin/claude
CLAUDE_MODEL=opus
PERMISSION_MODE=bypassPermissions
# Рабочую директорию тоже проставит install.sh (в <проект>/workspace).
WORKSPACE=./workspace

# ---- Прочее ----
LOG_LEVEL=INFO
EDIT_INTERVAL=2.0

# Локальное распознавание (работает без ключей): русский файнтюн large-v3-turbo.
LOCAL_STT_MODEL=dvislobokov/faster-whisper-large-v3-turbo-russian
# 1 — при сбое облачного STT доделать локально. В облачном режиме ставь 0:
# локального движка на слабом сервере нет, и откат на него только выдал бы ошибку.
LOCAL_STT_FALLBACK=1

# ---- Postgres ----
# Заполняется автоматически скриптом scripts/setup_db.sh (роль, база, pgvector,
# реальный порт кластера). Руками трогать нужно, только если ставишь БД сам.
# Формат: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@127.0.0.1:ПОРТ/БАЗА
DATABASE_DSN=

# ---- Внешние модели (необязательно) ----
# Служебные чат-вызовы через OpenRouter (или другой OpenAI-совместимый шлюз).
# Это НЕ тот claude, что ведёт разговор, — тот запускается локально.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-opus-5

# Эмбеддинги для смыслового поиска по памяти. Без ключа поиск вырождается в
# полнотекстовый — бот работает, просто «по смыслу» искать перестаёт.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://openrouter.ai/api/v1
EMBEDDINGS_MODEL=baai/bge-m3
# Обязан совпадать с vector(N) в БД. Не совпало — `cli.py embeddings resize N`.
EMBEDDINGS_DIM=1024
